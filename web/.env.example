# =============================================================================
# StudyConnect Frontend Environment Configuration (.env.example)
# Copy this file to web/.env before starting the development server.
# =============================================================================

# Leave empty in local development to route API requests through the Vite proxy (http://localhost:5000)
VITE_API_URL=

# Leave empty in local development to connect Socket.IO through the Vite dev server proxy
VITE_SOCKET_URL=

# Stream Chat Public API Key (must match STREAM_API_KEY in backend/.env)
VITE_STREAM_API_KEY=your_stream_api_key_here

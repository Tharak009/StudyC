# =============================================================================
# StudyConnect Production Environment Reference (Root Blueprint)
# =============================================================================

# Backend Environment Variables (configured on Render Web Service: studyconnect-backend)
NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/studyconnect?retryWrites=true&w=majority
CLIENT_URL=https://studyconnect-frontend.onrender.com
FRONTEND_URL=https://studyconnect-frontend.onrender.com
APPROVED_EMAIL_DOMAINS=campus.edu,college.edu,students.college.edu
JWT_ACCESS_SECRET=change-this-to-a-very-long-and-secure-random-access-secret-for-production
JWT_REFRESH_SECRET=change-this-to-a-very-long-and-secure-random-refresh-secret-for-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=true
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
LOG_LEVEL=combined

# Frontend Environment Variables (configured on Render Static Site: studyconnect-frontend)
VITE_API_URL=https://studyconnect-backend.onrender.com
VITE_SOCKET_URL=https://studyconnect-backend.onrender.com

# =============================================================================
# StudyConnect Backend Production Environment Blueprint
# =============================================================================
NODE_ENV=production
PORT=10000

# MongoDB Atlas / Cloud Replica Set Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/studyconnect?retryWrites=true&w=majority

# Allowed Frontend Origins (Comma-separated for multi-domain support)
# Render wildcard origins (*.onrender.com) are automatically matched dynamically.
CLIENT_URL=https://studyconnect-frontend.onrender.com
FRONTEND_URL=https://studyconnect-frontend.onrender.com

# Approved Campus Email Domains for Student/Faculty Verification
APPROVED_EMAIL_DOMAINS=campus.edu,college.edu,students.college.edu

# Cryptographically Secure JWT Signing Keys (Minimum 32 random characters each)
JWT_ACCESS_SECRET=change-this-to-a-very-long-and-secure-random-access-secret-for-production
JWT_REFRESH_SECRET=change-this-to-a-very-long-and-secure-random-refresh-secret-for-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Password Hashing Cost Factor (12 recommended for production)
BCRYPT_ROUNDS=12

# Cookie Security (Must be true in production behind HTTPS / Render SSL)
COOKIE_SECURE=true

# Storage and Upload Configurations
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Production HTTP Request Logging Level
LOG_LEVEL=combined

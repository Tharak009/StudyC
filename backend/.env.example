# =============================================================================
# StudyConnect Backend Environment Configuration (.env.example)
# =============================================================================

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/studyconnect
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Comma-separated, lower-case college domains allowed for student registration.
APPROVED_EMAIL_DOMAINS=campus.edu,college.edu,students.college.edu

# Authentication & JWT Secrets (at least 32 characters in production)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

COOKIE_SECURE=false
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
LOG_LEVEL=dev

# -----------------------------------------------------------------------------
# Stream Chat Service (Required for messaging and study meeting persistent chat)
# Obtain from https://getstream.io/dashboard/
# -----------------------------------------------------------------------------
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# -----------------------------------------------------------------------------
# LiveKit SFU Service (Required for 1:1 voice/video calls & group study meetings)
# Obtain from https://cloud.livekit.io/
# -----------------------------------------------------------------------------
# LIVEKIT_URL is the WebSocket connection URL (e.g. wss://your-project.livekit.cloud)
LIVEKIT_URL=wss://your-subdomain.livekit.cloud
# LIVEKIT_API_URL is the HTTPS API URL (e.g. https://your-project.livekit.cloud); derived from LIVEKIT_URL if omitted
LIVEKIT_API_URL=https://your-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_TOKEN_TTL_SECONDS=3600
GROUP_CALL_MAX_PARTICIPANTS=100

# -----------------------------------------------------------------------------
# WebRTC ICE Servers (STUN/TURN fallback for direct calls)
# -----------------------------------------------------------------------------
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Optional Storage Configuration (AUTO / LOCAL / CLOUD)
# If STORAGE_MODE=LOCAL, uploaded documents are stored in UPLOAD_DIR on disk.
# -----------------------------------------------------------------------------
STORAGE_MODE=LOCAL
# S3 / Backblaze B2 settings (only needed if STORAGE_MODE=CLOUD):
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

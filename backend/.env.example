NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/studyconnect
CLIENT_URL=http://localhost:5173

# Comma-separated, lower-case college domains.
APPROVED_EMAIL_DOMAINS=college.edu,students.college.edu

# Generate separate random values of at least 32 characters for production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

COOKIE_SECURE=false
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
LOG_LEVEL=dev

# Stream Chat Credentials (Backend-only secret)
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# WebRTC ICE Servers (STUN/TURN)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Group-call SFU (self-hosted LiveKit). Leave blank until a LiveKit server is provisioned.
# LIVEKIT_URL is the browser WebSocket URL (wss:// in production).
# LIVEKIT_API_URL is the server HTTPS API URL; if omitted, it is derived from LIVEKIT_URL.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
GROUP_CALL_MAX_PARTICIPANTS=100
